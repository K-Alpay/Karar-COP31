    /* ============================================================
       VIDEO CONTROLLER & 5-TIER FALLBACK SKYLINE
       ============================================================ */
    let currentVideoPath = '';

    function getTargetVideoPath(ecoScore) {
      if (ecoScore > 80) return 'videos/city_5.mp4';
      if (ecoScore > 60) return 'videos/city_4.mp4';
      if (ecoScore > 40) return 'videos/city_3.mp4';
      if (ecoScore > 20) return 'videos/city_2.mp4';
      return 'videos/city_1.mp4';
    }

    function updateVideoSource(ecoScore) {
      const targetPath = getTargetVideoPath(ecoScore);
      if (targetPath !== currentVideoPath) {
        currentVideoPath = targetPath;
        videoSource.src = targetPath;
        windowVideo.load();
        windowVideo.play().then(() => {
          windowVideo.classList.add('active');
        }).catch(() => {
          windowVideo.classList.remove('active');
        });
      }
    }

    windowVideo.addEventListener('loadeddata', () => windowVideo.classList.add('active'));
    windowVideo.addEventListener('error', () => windowVideo.classList.remove('active'));

    function renderWindowView(ecoScore) {
      updateVideoSource(ecoScore);

      if (ecoScore <= 20) {
        skyBackdrop.style.background = "linear-gradient(180deg, #451010 0%, #200909 50%, #120505 100%)";
        citySvg.innerHTML = `
          <rect x="30" y="70" width="45" height="110" fill="#241313" />
          <rect x="42" y="45" width="16" height="25" fill="#3b1d1d" />
          <circle class="smoke-puff" cx="50" cy="40" r="12" fill="#704e4e" />
          <rect x="100" y="60" width="55" height="120" fill="#1c0f0f" />
          <rect x="180" y="35" width="50" height="145" fill="#2b1515" />
          <rect x="195" y="15" width="14" height="20" fill="#422020" />
          <circle class="smoke-puff" cx="202" cy="12" r="14" fill="#805b5b" style="animation-delay: 0.8s;" />
          <rect x="260" y="80" width="65" height="100" fill="#1a0d0d" />
          <rect x="350" y="55" width="55" height="125" fill="#261212" />
          <rect x="430" y="45" width="50" height="135" fill="#331919" />
          <circle class="smoke-puff" cx="452" cy="40" r="12" fill="#755252" style="animation-delay: 1.3s;" />
          <rect x="510" y="75" width="70" height="105" fill="#1f0e0e" />
          <rect x="0" y="170" width="600" height="10" fill="#2d1710" />
        `;
      } else if (ecoScore <= 40) {
        skyBackdrop.style.background = "linear-gradient(180deg, #3d3528 0%, #221d15 50%, #15120c 100%)";
        citySvg.innerHTML = `
          <rect x="35" y="75" width="45" height="105" fill="#24211a" />
          <rect x="48" y="55" width="14" height="20" fill="#383329" />
          <circle class="smoke-puff" cx="55" cy="50" r="9" fill="#6e6757" />
          <rect x="105" y="65" width="55" height="115" fill="#29261f" />
          <rect x="185" y="45" width="45" height="135" fill="#363127" />
          <circle class="smoke-puff" cx="205" cy="40" r="10" fill="#78705f" style="animation-delay: 1s;" />
          <rect x="255" y="80" width="60" height="100" fill="#24201a" />
          <rect x="345" y="60" width="55" height="120" fill="#302b22" />
          <rect x="430" y="55" width="50" height="125" fill="#2e2920" />
          <rect x="505" y="70" width="65" height="110" fill="#26221b" />
          <rect x="0" y="170" width="600" height="10" fill="#332a1d" />
        `;
      } else if (ecoScore <= 60) {
        skyBackdrop.style.background = "linear-gradient(180deg, #1e3a5f 0%, #0f2438 60%, #0a1724 100%)";
        citySvg.innerHTML = `
          <rect x="35" y="80" width="50" height="100" fill="#1e293b" />
          <rect x="42" y="75" width="36" height="5" fill="#38bdf8" />
          <rect x="110" y="55" width="60" height="125" fill="#334155" />
          <polygon points="110,55 140,30 170,55" fill="#475569" />
          <circle cx="205" cy="140" r="22" fill="#15803d" />
          <circle cx="230" cy="135" r="28" fill="#166534" />
          <rect x="280" y="50" width="55" height="130" fill="#1e293b" />
          <rect x="365" y="70" width="50" height="110" fill="#334155" />
          <rect x="440" y="60" width="60" height="120" fill="#1e293b" />
          <rect x="525" y="75" width="55" height="105" fill="#293548" />
          <rect x="0" y="170" width="600" height="10" fill="#0284c7" />
        `;
      } else if (ecoScore <= 80) {
        skyBackdrop.style.background = "linear-gradient(180deg, #0e5040 0%, #08382c 60%, #04211a 100%)";
        citySvg.innerHTML = `
          <g transform="translate(35, 45)">
            <rect x="19" y="24" width="2" height="60" fill="#f8fafc" />
            <circle cx="20" cy="24" r="3" fill="#38bdf8" />
            <g class="wind-turbine-blade" style="transform-origin: 20px 24px;">
              <line x1="20" y1="24" x2="20" y2="6" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="36" y2="33" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="4" y2="33" stroke="#f8fafc" stroke-width="2" />
            </g>
          </g>
          <rect x="95" y="60" width="60" height="120" fill="#065f46" rx="4" />
          <rect x="100" y="55" width="50" height="5" fill="#38bdf8" />
          <circle cx="180" cy="140" r="26" fill="#10b981" />
          <circle cx="215" cy="130" r="30" fill="#059669" />
          <rect x="270" y="45" width="60" height="135" fill="#047857" rx="4" />
          <circle cx="300" cy="38" r="10" fill="#34d399" />
          <rect x="360" y="65" width="55" height="115" fill="#065f46" />
          <rect x="440" y="55" width="60" height="125" fill="#047857" />
          <g transform="translate(520, 50)">
            <rect x="19" y="24" width="2" height="55" fill="#f8fafc" />
            <circle cx="20" cy="24" r="3" fill="#38bdf8" />
            <g class="wind-turbine-blade" style="transform-origin: 20px 24px; animation-duration: 2.5s;">
              <line x1="20" y1="24" x2="20" y2="6" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="36" y2="33" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="4" y2="33" stroke="#f8fafc" stroke-width="2" />
            </g>
          </g>
          <rect x="0" y="168" width="600" height="12" fill="#059669" />
        `;
      } else {
        skyBackdrop.style.background = "linear-gradient(180deg, #065f46 0%, #064e3b 50%, #022c22 100%)";
        citySvg.innerHTML = `
          <g class="bird-flock">
            <path d="M 10 25 Q 16 18 22 25 Q 28 18 34 25" stroke="#a7f3d0" stroke-width="2" fill="none" />
            <path d="M 32 35 Q 37 30 42 35 Q 47 30 52 35" stroke="#a7f3d0" stroke-width="1.6" fill="none" />
          </g>
          <g transform="translate(35, 30)">
            <rect x="19" y="24" width="2" height="70" fill="#f8fafc" />
            <circle cx="20" cy="24" r="3" fill="#38bdf8" />
            <g class="wind-turbine-blade" style="transform-origin: 20px 24px;">
              <line x1="20" y1="24" x2="20" y2="4" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="37" y2="34" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="3" y2="34" stroke="#f8fafc" stroke-width="2" />
            </g>
          </g>
          <rect x="100" y="55" width="65" height="125" fill="#047857" rx="8" />
          <circle cx="132" cy="48" r="14" fill="#10b981" />
          <path d="M 190 180 L 190 50 Q 235 25 280 50 L 280 180 Z" fill="#065f46" />
          <circle cx="235" cy="65" r="12" fill="#34d399" />
          <circle cx="320" cy="140" r="30" fill="#10b981" />
          <circle cx="355" cy="135" r="26" fill="#059669" />
          <g transform="translate(490, 35)">
            <rect x="19" y="24" width="2" height="65" fill="#f8fafc" />
            <circle cx="20" cy="24" r="3" fill="#38bdf8" />
            <g class="wind-turbine-blade" style="transform-origin: 20px 24px; animation-duration: 2.3s;">
              <line x1="20" y1="24" x2="20" y2="4" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="37" y2="34" stroke="#f8fafc" stroke-width="2" />
              <line x1="20" y1="24" x2="3" y2="34" stroke="#f8fafc" stroke-width="2" />
            </g>
          </g>
          <rect x="400" y="60" width="65" height="120" fill="#047857" rx="6" />
          <rect x="0" y="164" width="600" height="16" fill="#059669" />
        `;
      }
    }

    /* ============================================================
       LOAD MEMO & METRICS
       ============================================================ */
    function updateMetrics(deltas = null) {
      stats.budget = Math.max(0, Math.min(100, stats.budget));
      stats.eco = Math.max(0, Math.min(100, stats.eco));
      stats.youth = Math.max(0, Math.min(100, stats.youth));
      stats.mayor = Math.max(0, Math.min(100, stats.mayor));

      barB.style.width = stats.budget + '%';
      barE.style.width = stats.eco + '%';
      barY.style.width = stats.youth + '%';
      barM.style.width = stats.mayor + '%';

      valB.textContent = stats.budget + '%';
      valE.textContent = stats.eco + '%';
      valY.textContent = stats.youth + '%';
      valM.textContent = stats.mayor + '%';

      if (deltas) {
        showDelta(deltaB, deltas.budget);
        showDelta(deltaE, deltas.eco);
        showDelta(deltaY, deltas.youth);
        showDelta(deltaM, deltas.mayor);
      }

      renderWindowView(stats.eco);
      checkGameOver();
    }

    function showDelta(el, val) {
      if (!val || val === 0) return;
      el.textContent = val > 0 ? `+${val}` : `${val}`;
      el.className = val > 0 ? 'stat-floating-delta animate-pos' : 'stat-floating-delta animate-neg';
      setTimeout(() => el.className = 'stat-floating-delta', 650);
    }

    function loadMemo() {
      if (cardIndex >= deck.length) {
        deck = [...officialMemos].sort(() => Math.random() - 0.5);
        cardIndex = 0;
      }

      const item = deck[cardIndex];
      memoSubject.textContent = item.subject;
      memoSender.textContent = item.sender;
      memoBody.textContent = `"${item.body}"`;
      memoRisk.textContent = item.risk;
      memoNo.textContent = `78241029-622-E.${1040 + totalDossiersCompleted}`;
      memoDate.textContent = `${10 + currentDay}.11.2031`;
      const memoAvatar = document.getElementById('memoAvatar');
      if (memoAvatar && item.avatar) {
        memoAvatar.src = item.avatar;
      }

      const timeSlotStr = timeSlots[dossierInDay - 1];
      memoTimeSlot.textContent = timeSlotStr;

      hudDayText.textContent = `📅 ${currentDay}. GÜN`;
      hudShiftText.textContent = `${timeSlotStr} • Evrak ${dossierInDay}/4`;

      stampApproved.classList.remove('stamped');
      stampRejected.classList.remove('stamped');
      activePaper.style.transition = 'transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease';
      activePaper.style.transform = 'translate(0px, 0px) rotate(0deg)';

      resetPreviewDots();
      soundPaperSlide();

      // Check dynamic phone trigger: rings once every day on 2nd dossier, OR if Mayor is angry
      if ((dossierInDay === 2) || (stats.mayor < 30 && dossierInDay === 3)) {
        setTimeout(() => {
          triggerMayorCall();
        }, 600);
      }
    }

    /* ============================================================
       DYNAMIC MAYOR TELEPHONE & SLIDING CALL BANNER
       ============================================================ */
    const incomingCallBanner = document.getElementById('incomingCallBanner');
    const btnAnswerBanner = document.getElementById('btnAnswerBanner');

    function triggerMayorCall() {
      hotlineContainer.classList.add('ringing');
      if (incomingCallBanner) incomingCallBanner.classList.add('active');
      soundPhoneRing();
    }

    function answerMayorCall() {
      if (incomingCallBanner) incomingCallBanner.classList.remove('active');
      hotlineContainer.classList.remove('ringing');
        
        if (stats.mayor < 35) {
          hotlineIcon.textContent = "😡";
          hotlineCaller.textContent = "BELEDİYE BAŞKANI CENGİZ BEY";
          hotlineCallerMood.textContent = "Öfkeli & Tehditkar (Güven: %" + stats.mayor + ")";
          hotlineText.textContent = '"Sen benim sabrımı mı sınıyorsun müdür?! Masandaki dosyaları kafana göre reddedip duruyorsun, esnaf kapıma dayandı! Bu belediyede son sözü ben söylerim. Bir hata daha yaparsan o makamı başına yıkarım, anladın mı beni?!"';
        } else if (stats.mayor > 65) {
          hotlineIcon.textContent = "😄";
          hotlineCaller.textContent = "BELEDİYE BAŞKANI CENGİZ BEY";
          hotlineCallerMood.textContent = "Memnun & Gururlu (Güven: %" + stats.mayor + ")";
          hotlineText.textContent = '"Müdür bey, tebrik ederim! Hem esnafı idare ediyorsun hem de gençlerin desteği arkamızda. Şehirde hava değişmeye başladı bile. COP31 ödülünü birlikte alacağız. Sana ek fon açtırıyorum, aynen böyle devam!"';
        } else {
          hotlineIcon.textContent = "👔";
          hotlineCaller.textContent = "BELEDİYE BAŞKANI CENGİZ BEY";
          hotlineCallerMood.textContent = "Temkinli & Uyarıcı (Güven: %" + stats.mayor + ")";
          hotlineText.textContent = '"Müdürüm, dengeleri iyi gözet. Gençlerin her istediğine imza atıp bütçeyi delme ama basına da kirlilik manşeti düşürme. Gözüm senin masanda haberin olsun!"';
        }

        hotlineModal.classList.add('active');
        soundChime();
    }

    // Universal Touch & Click listeners for telephone and sliding banner
    ['click', 'touchend', 'pointerup'].forEach(evt => {
      hotlineContainer.addEventListener(evt, (e) => {
        if (hotlineContainer.classList.contains('ringing')) {
          e.preventDefault();
          answerMayorCall();
        }
      });

      if (btnAnswerBanner) {
        btnAnswerBanner.addEventListener(evt, (e) => {
          e.preventDefault();
          answerMayorCall();
        });
      }

      if (incomingCallBanner) {
        incomingCallBanner.addEventListener(evt, (e) => {
          e.preventDefault();
          answerMayorCall();
        });
      }
    });

    btnHotlineAction.addEventListener('click', () => hotlineModal.classList.remove('active'));
    btnHotlineAction.addEventListener('touchend', (e) => {
      e.preventDefault();
      hotlineModal.classList.remove('active');
    });
    btnNewsClose.addEventListener('click', () => newsModal.classList.remove('active'));

    /* ============================================================
       PREVIEW IMPACT DOTS
       ============================================================ */
    function showPreviewDots(choice) {
      trayReject.classList.toggle('highlight', choice === 'reject');
      trayAccept.classList.toggle('highlight', choice === 'accept');
    }

    function resetPreviewDots() {
      trayReject.classList.remove('highlight');
      trayAccept.classList.remove('highlight');
    }

    /* ============================================================
       DECISION ACTIONS (Sign & Put Right / Reject & Put Left)
       ============================================================ */
    let isProcessing = false;

    function executeDecision(choice) {
      if (isGameOver || isProcessing) return;
      isProcessing = true;

      if (onboardingHint) onboardingHint.style.opacity = '0';

      const item = deck[cardIndex];
      const outcome = choice === 'accept' ? item.accept : item.reject;

      if (choice === 'accept') {
        acceptedCount++;
        stampApproved.classList.add('stamped');
        soundStamp(true);
        setTimeout(() => {
          activePaper.style.transition = 'transform 0.3s ease-in';
          activePaper.style.transform = 'translate(450px, -30px) rotate(20deg)';
        }, 130);
      } else {
        stampRejected.classList.add('stamped');
        soundStamp(false);
        setTimeout(() => {
          activePaper.style.transition = 'transform 0.3s ease-in';
          activePaper.style.transform = 'translate(-450px, -30px) rotate(-20deg)';
        }, 130);
      }

      setTimeout(() => {
        stats.budget += outcome.effects.budget;
        stats.eco += outcome.effects.eco;
        stats.youth += outcome.effects.youth;
        stats.mayor += outcome.effects.mayor;

        updateMetrics(outcome.effects);
        totalDossiersCompleted++;
        dossierInDay++;
        cardIndex++;

        if (outcome.news) {
          setTimeout(() => {
            newsHeadline.textContent = outcome.news.headline;
            newsHeadline.className = outcome.news.good ? 'newspaper-headline good' : 'newspaper-headline';
            newsBody.textContent = outcome.news.text;
            soundNewspaperSlam();
            newsModal.classList.add('active');
          }, 300);
        }

        if (dossierInDay > DOSSIERS_PER_DAY) {
          if (currentDay < TOTAL_DAYS && !isGameOver) {
            triggerDayEnd();
            isProcessing = false;
            return;
          } else if (!isGameOver) {
            triggerVictory();
            isProcessing = false;
            return;
          }
        }

        if (!isGameOver) {
          loadMemo();
        }
        isProcessing = false;
      }, 460);
    }

    /* ============================================================
       DAY END TRANSITION
       ============================================================ */
    function triggerDayEnd() {
      soundDayTransition();
      dayEndTitle.textContent = `${currentDay}. GÜNÜN MESAİSİ BİTTİ`;
      
      let statusDesc = "Gelişmekte";
      if (stats.eco > 65) statusDesc = "Temiz & Umut Dolu";
      else if (stats.eco < 35) statusDesc = "Dumanlı & Alarm Seviyesinde";
      recapCityStatus.textContent = statusDesc;

      dayEndDesc.textContent = `Belediye otobüsünün camına yaslanıp şehri izliyorsun. Bugün onayladığın kararlar sokaklara yansımaya başladı. Şehrin havası şu anda ${statusDesc.toLowerCase()}. Yarın seni daha kritik evraklar bekliyor.`;

      dayEndModal.classList.add('active');
    }

    btnNextDay.addEventListener('click', () => {
      dayEndModal.classList.remove('active');
      currentDay++;
      dossierInDay = 1;
      loadMemo();
    });

    /* ============================================================
       DRAG & SLIDE PHYSICS
       ============================================================ */
    let startX = 0;
    let startY = 0;
    let currentX = 0;
    let currentY = 0;
    let isDragging = false;
    const DRAG_THRESHOLD = 80;

    function onDragStart(x, y) {
      if (isGameOver || isProcessing) return;
      isDragging = true;
      startX = x;
      startY = y;
      activePaper.style.transition = 'none';
    }

    function onDragMove(x, y) {
      if (!isDragging || isGameOver || isProcessing) return;
      currentX = x - startX;
      currentY = y - startY;

      const rotateDeg = currentX * 0.055;
      activePaper.style.transform = `translate(${currentX}px, ${currentY * 0.25}px) rotate(${rotateDeg}deg)`;

      if (currentX > 35) {
        showPreviewDots('accept');
      } else if (currentX < -35) {
        showPreviewDots('reject');
      } else {
        resetPreviewDots();
      }
    }

    function onDragEnd() {
      if (!isDragging || isGameOver || isProcessing) return;
      isDragging = false;
      resetPreviewDots();

      if (currentX > DRAG_THRESHOLD) {
        executeDecision('accept');
      } else if (currentX < -DRAG_THRESHOLD) {
        executeDecision('reject');
      } else {
        activePaper.style.transition = 'transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1)';
        activePaper.style.transform = 'translate(0px, 0px) rotate(0deg)';
      }
      currentX = 0;
      currentY = 0;
    }

    activePaper.addEventListener('mousedown', (e) => onDragStart(e.clientX, e.clientY));
    window.addEventListener('mousemove', (e) => onDragMove(e.clientX, e.clientY));
    window.addEventListener('mouseup', onDragEnd);

    activePaper.addEventListener('touchstart', (e) => onDragStart(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    window.addEventListener('touchmove', (e) => { if (isDragging) onDragMove(e.touches[0].clientX, e.touches[0].clientY); }, { passive: true });
    window.addEventListener('touchend', onDragEnd);

    btnSign.addEventListener('click', () => executeDecision('accept'));
    btnReject.addEventListener('click', () => executeDecision('reject'));
    trayAccept.addEventListener('click', () => executeDecision('accept'));
    trayReject.addEventListener('click', () => executeDecision('reject'));

    window.addEventListener('keydown', (e) => {
      if (isGameOver || isProcessing) return;
      if (e.key === 'ArrowRight' || e.key === 'd' || e.key === 'D') executeDecision('accept');
      if (e.key === 'ArrowLeft' || e.key === 'a' || e.key === 'A') executeDecision('reject');
    });

    btnSign.addEventListener('mouseenter', () => showPreviewDots('accept'));
    btnSign.addEventListener('mouseleave', resetPreviewDots);
    btnReject.addEventListener('mouseenter', () => showPreviewDots('reject'));
    btnReject.addEventListener('mouseleave', resetPreviewDots);

    /* ============================================================
       FINAL REPORT CARD
       ============================================================ */
    function checkGameOver() {
      if (stats.budget <= 0) {
        triggerDefeat("F", "Şehir İflas Etti!", "Çevre bütçesi tamamen tükendi. Belediyeye kayyum atandı ve makamınız mühürlendi.");
      } else if (stats.mayor <= 0) {
        triggerDefeat("F", "Makamdan Alındınız!", "Başkanın sabrı taştı! 'Bana çevreci değil laf dinleyen bürokrat lazım' diyerek seni görevden aldı.");
      } else if (stats.youth <= 0) {
        triggerDefeat("F", "Gençler Şehri Terk Etti!", "Gençlerin dosyalarını sürekli reddettiniz. Şehirde büyük bir beyin göçü başladı, tüm inovasyon durdu.");
      } else if (stats.eco <= 0) {
        triggerDefeat("F", "Ekolojik Çöküş!", "Şehir asit yağmurları ve duman altında kaldı. COP31 heyeti şehre kırmızı alarm verdi ve zirveden ihraç edildiniz.");
      }
    }

    function triggerDefeat(grade, title, desc) {
      isGameOver = true;
      soundNewspaperSlam();
      reportGrade.textContent = grade;
      reportGrade.style.background = "linear-gradient(135deg, #b91c1c 0%, #7f1d1d 100%)";
      reportCarbon.textContent = "+%45 Kirlilik Artışı";
      reportAcceptedCount.textContent = `${acceptedCount} Proje İmzalandı`;
      reportFinalBudget.textContent = `%${stats.budget} (Kritik)`;
      reportFinalMayor.textContent = `%${stats.mayor} (Öfkeli)`;
      resultModal.classList.add('active');
    }

    function triggerVictory() {
      isGameOver = true;
      soundWin();
      
      let grade = "B";
      if (stats.eco >= 75 && stats.youth >= 60) grade = "S";
      else if (stats.eco >= 55) grade = "A";

      reportGrade.textContent = grade;
      reportGrade.style.background = grade === "S" ? "linear-gradient(135deg, #d4af37 0%, #047857 100%)" : "linear-gradient(135deg, #047857 0%, #064e3b 100%)";
      reportCarbon.textContent = `-%${Math.round(stats.eco * 0.7)} Emisyon`;
      reportAcceptedCount.textContent = `${acceptedCount} Proje Yürürlükte`;
      reportFinalBudget.textContent = `%${stats.budget} (Başarılı)`;
      reportFinalMayor.textContent = `%${stats.mayor} (Tam Güven)`;
      resultModal.classList.add('active');
    }

    function restartGame() {
      stats = { budget: 50, eco: 45, youth: 55, mayor: 50 };
      currentDay = 1;
      dossierInDay = 1;
      totalDossiersCompleted = 0;
      acceptedCount = 0;
      isGameOver = false;
      cardIndex = 0;
      deck = [...officialMemos].sort(() => Math.random() - 0.5);
      resultModal.classList.remove('active');
      newsModal.classList.remove('active');
      hotlineModal.classList.remove('active');
      dayEndModal.classList.remove('active');
      if (onboardingHint) onboardingHint.style.opacity = '1';
      updateMetrics();
      loadMemo();
    }

    btnRestart.addEventListener('click', restartGame);

    // Initial Start
    updateMetrics();
    loadMemo();
  </script>
<script>
    /* PWA Service Worker Registration */
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js')
          .then(reg => console.log('Service Worker registered:', reg.scope))
          .catch(err => console.log('Service Worker registration failed:', err));
      });
    }
</script>
</body>
</html>
